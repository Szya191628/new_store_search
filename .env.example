# 数据库配置 (支持 mysql 或 sqlite 测试模式)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=radar_user
MYSQL_PASSWORD=radar_pass_change_me
MYSQL_DATABASE=new_store_radar

# 高德开放平台 Web服务 API Key (也可在 Web 看板后台页面直接配置)
AMAP_API_KEY=

# 默认目标城市/区县（用于高德地理编码提纯）
DEFAULT_CITY=

# Playwright 后台核验开关 (true/false)
ENABLE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_MIN_DELAY_SEC=3
PLAYWRIGHT_MAX_DELAY_SEC=6

# 会话密钥
APP_SECRET=change-this-to-a-random-string
